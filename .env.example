# Shared local settings for Docker Compose, FastAPI/Alembic and Next.js.
# Copy to root .env once. Never commit .env or expose it through the frontend.

# PostgreSQL container (local development only)
POSTGRES_DB=wehire_dev
POSTGRES_USER=wehire
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=54312

# FastAPI / Alembic (server-side only)
APP_NAME="WeHire API"
CORS_ORIGINS=["http://localhost:3012"]
# Match the PostgreSQL settings above; URL-encode special password characters.
DATABASE_URL=postgresql+psycopg://wehire:change-me@127.0.0.1:54312/wehire_dev

# Next.js: only NEXT_PUBLIC_ variables may be sent to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8012
