# Shared local settings for Docker Compose, FastAPI/Alembic and Next.js.
# Copy to root .env once. Never commit .env or expose it through the frontend.

# PostgreSQL container (local development only)
POSTGRES_DB=wehire_dev
POSTGRES_USER=wehire
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=54312

# Docker host ports; container ports remain 3012 (frontend) and 8012 (backend).
FRONTEND_PORT=3012
BACKEND_PORT=8012

# FastAPI / Alembic (server-side only)
APP_NAME="WeHire API"
CORS_ORIGINS=["http://localhost:3012"]
# Match the PostgreSQL settings above; URL-encode special password characters.
# Keep the host address here for host-based development. Compose supplies
# DATABASE_HOST=postgres and DATABASE_PORT=5432 to the backend only.
DATABASE_URL=postgresql+psycopg://wehire:change-me@127.0.0.1:54312/wehire_dev

# One-time administrator setup: private random key of at least 32 characters.
# Leave blank to disable setup; remove after creating the first administrator.
BOOTSTRAP_TOKEN=

# Authentication: false ONLY for local HTTP; use true with HTTPS in deployment.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
# Candidate registration has independent per-email and per-IP limits.
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REGISTER_EMAIL_LIMIT=3
AUTH_REGISTER_IP_LIMIT=10

# Next.js: only NEXT_PUBLIC_ variables may be sent to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8012

# Optional Next.js SERVER-ONLY API address for host-based development.
# Leave blank to fall back to NEXT_PUBLIC_API_URL. Compose sets http://backend:8012.
# Never prefix this variable with NEXT_PUBLIC_.
INTERNAL_API_URL=

# If changing host ports, also update NEXT_PUBLIC_API_URL and CORS_ORIGINS above.
